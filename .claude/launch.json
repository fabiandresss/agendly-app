{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/index.js"
      ],
      "port": 3000,
      "env": {
        "DISABLE_REMINDER_JOB": "1"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        ".claude/dev_server.py",
        "5500",
        "frontend"
      ],
      "port": 5500
    }
  ]
}