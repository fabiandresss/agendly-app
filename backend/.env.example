# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_KEY=                 # anon key
SUPABASE_SERVICE_ROLE_KEY=    # solo backend, nunca en el frontend

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=                   # ej: "Agendly <reservas@tudominio.cl>" (dominio verificado en Resend)

# URL pública del frontend (sin / final): se usa en los links de cancelar/reagendar
FRONTEND_URL=http://localhost:5500

# Opcionales
BUSINESS_TIMEZONE=America/Santiago
CORS_ORIGIN=                  # ej: https://tu-frontend.com (vacío = cualquier origen)
TRUST_PROXY=                  # 1 si el backend corre detrás de un proxy
